# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL/PostGIS (local Homebrew postgresql@17)
DATABASE_URL=postgresql+asyncpg://satellite_detection:change-me@localhost:5432/satellite_detection
# Separate database for integration tests (wiped by the test suite). Leave unset to skip them.
TEST_DATABASE_URL=postgresql+asyncpg://satellite_detection:change-me@localhost:5432/satellite_detection_test

# RabbitMQ (local Homebrew). The guest user only accepts connections from localhost.
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# MinIO / S3-compatible object storage. `make minio` uses these as MinIO's root credentials.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=satellite-detection-admin
S3_SECRET_KEY=change-me-min-8-chars
S3_BUCKET=satellite-detection

# Allowed browser origins for the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
